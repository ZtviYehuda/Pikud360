# --- PostgreSQL / Google Cloud SQL Database Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_123
POSTGRES_DB=matzevet_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional full URI or Cloud SQL Unix Socket:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/matzevet_db
# POSTGRES_HOST=/cloudsql/PROJECT_ID:me-west1:matzevet-db-prod

# Connection pool settings
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10

# --- Backend Flask Configuration ---
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
JWT_SECRET_KEY=change_this_to_another_secure_random_hex_key_in_production
PORT=8080

# --- Google Cloud Storage (GCS) Configuration ---
USE_GCS=true
GCS_BUCKET_NAME=matzevet-media-prod

# --- WhatsApp Gateway Service ---
WHATSAPP_GATEWAY_URL=http://localhost:3001

# --- SMTP / Email Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@pikud360.gov.il
SMTP_PASSWORD=app_specific_password_here
SMTP_FROM_EMAIL=no-reply@pikud360.gov.il
SMTP_USE_TLS=true

# --- Frontend Configuration ---
VITE_API_URL=/api
